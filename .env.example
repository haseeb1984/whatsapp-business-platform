APP_NAME="WhatsApp Business Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
PLATFORM_ADMIN_EMAILS=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=null
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=whatsapp_business
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
META_APPOINTMENT_REMINDER_TEMPLATE=appointment_reminder
META_APPOINTMENT_REMINDER_LANGUAGE=en_US

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=15
GROQ_RATE_LIMIT_COOLDOWN_SECONDS=60
AI_USAGE_RETENTION_DAYS=90

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/business/calendar/callback
GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo

VITE_APP_NAME="${APP_NAME}"
